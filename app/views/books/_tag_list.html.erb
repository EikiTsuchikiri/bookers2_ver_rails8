<div class="tags">
  <% if tags.present? %>
    <div class="d-flex flex-wrap">
      <% tags.each do |tag| %>
        <span class="badge bg-info me-2 mb-2">
          <%= link_to "#{tag.name}(#{tag.taggings_count})", books_path(tag_name: tag.name), class: "text-white" %>
        </span>
      <% end %>
    </div>
  <% else %>
    <p>登録されているタグはありません</p>
  <% end %>
</div>