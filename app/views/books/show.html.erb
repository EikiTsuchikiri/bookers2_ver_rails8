<div class="container">
  <div class="row">
    <div class="col-md-3">
      <%= render "users/info", user: @user %>
      <h2 class="mt-3">New book</h2>
      <%= render "form", book: @new_book %>
    </div>
    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>
      <table class="table">
        <tr>
          <td>
            <%= link_to user_path(@user) do%>
              <%= image_tag @user.get_profile_image(100, 100) %><br>
              <%= @user.name %>
            <% end %>
          </td>
          <td>
            <%= link_to @book.title, book_path(@book) %>
          </td>
          <td>
            <%= @book.body %>
          </td>
          <td>
            <%= render 'books/tag_list', tags: @book.tag_counts %>
          </td>
          <td id=<%= "favorite-#{@book.id}" %>>
            <%= render 'favorites/btn', book: @book %>
          </td>
          <td id="book-comments-counter">
            <%= render 'book_comments/counter', book: @book %>
          </td>
          <% if @user== Current.user %>
            <td>
              <%= link_to 'Edit', edit_book_path(@book), class: "btn btn-sm btn-success" %>
            </td>
            <td>
              <%= link_to 'Destroy', book_path(@book), data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？"}, class: "btn btn-sm btn-danger" %>
            </td>
          <% end %>
        </tr>
      </table>

      <div id="book-comments-index">
        <%= render 'book_comments/index', book: @book %>
      </div>

      <div id="book-comments-form">
        <%= render 'book_comments/form', book: @book, book_comment: @book_comment %>
      </div>
    </div>
  </div>
</div>