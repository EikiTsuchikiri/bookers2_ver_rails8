<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 vol-lg-5 px-5 px-sm-0 mx-auto">
      <h2>User info</h2>
      <%= form_with model: @user, local: true do |f| %>
        <%= render 'layouts/errors', obj: @user %>
        <div class="mb-3">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :profile_image, class: "form-label" %>
          <%= f.file_field :profile_image, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :introduction, class: "form-label" %>
          <%= f.text_area :introduction, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.submit class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>