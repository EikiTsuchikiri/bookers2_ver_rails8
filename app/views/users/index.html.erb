<div class="container px-5 px-sm-0">
  <%= render 'layouts/errors', obj: @book %>
  <div class="row">
    <div class="col-md-3">
      <%= render "info", user: Current.user %>
      <%= render "books/form", book: @book %>
    </div>
    <div class="col-md-8 offset-md-1">
      <h2>Users</h2>
      <%= render "index", users: @users %>
    </div>
  </div>
</div>